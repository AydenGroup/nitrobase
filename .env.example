# Copy to .env.local (development) or .env (production compose) and fill in.

# Development: `docker compose up -d postgres` publishes Postgres on 127.0.0.1:5443.
DATABASE_URL="postgresql://nitrobase:nitrobase@localhost:5443/nitrobase"

# Required, at least 32 random characters each: openssl rand -base64 32
# ENCRYPTION_KEY encrypts SSH keys/passwords at rest; changing it makes stored secrets unreadable.
ENCRYPTION_KEY=""
# After rotating ENCRYPTION_KEY, put the old key(s) here (comma separated) so
# backups made before the rotation can still be restored.
ENCRYPTION_KEY_PREVIOUS=""
SESSION_SECRET=""

# Public URL of the panel. Session cookies are marked Secure only when this starts with https://.
# Leave empty (or http://...) when first accessing over http://<server-ip>:3000.
APP_URL=""

# Email for Let's Encrypt registration (defaults to the admin account email).
ACME_EMAIL=""

# Optional: raises GitHub API rate limits for template version listing.
GITHUB_TOKEN=""

# Production compose only. Use hex (it is embedded in DATABASE_URL): openssl rand -hex 32
POSTGRES_PASSWORD=""
# Host binding for the panel (default 0.0.0.0:3000). Use 127.0.0.1:3000 once the panel is behind HTTPS.
PANEL_BIND=""

# Production compose: the panel image (without tag) and its tag. The in-panel
# upgrade (Settings → Instance) changes NITROBASE_VERSION.
NITROBASE_IMAGE=""
NITROBASE_VERSION=""
# Repository whose releases are offered as upgrades (owner/name); empty = no
# update check. Gitea/Forgejo: also set RELEASE_API_URL=https://<host>/api/v1.
RELEASE_REPO=""
# Panel domain set by the installer's --domain (Let's Encrypt via Traefik).
PANEL_DOMAIN=""
# One-time token for the first account / first-run restore (the installer
# generates it). Empty: whoever opens a fresh panel first may set it up.
SETUP_TOKEN=""
