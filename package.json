{
  "name": "nitrobase",
  "homepage": "https://nitrobase.app",
  "license": "FSL-1.1-ALv2",
  "version": "0.1.0-beta.4",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "install-lefthook": "lefthook install",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "i18n:compile": "lingui compile --typescript && biome format --write src/locales",
    "i18n:extract": "lingui extract --clean && biome format --write src/locales",
    "i18n:check": "bun scripts/lingui/check-catalogs.ts",
    "i18n:translate": "jsontt ./src/locales/en.json --module google --from en --to",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/museomoderno": "^5.3.0",
